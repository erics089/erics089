# ─────────────────────────────────────────────────────────────
# MIRRA Wellness Marketing Command Center — Umgebungsvariablen
# Kopiere diese Datei zu ".env.local" und trage deine Keys ein.
# Fehlende Keys lassen die App NICHT abstürzen — betroffene
# Features zeigen stattdessen einen "Verbindung einrichten"-Hinweis.
# Siehe README.md für eine Schritt-für-Schritt-Anleitung, wo du
# jeden Key bekommst.
# ─────────────────────────────────────────────────────────────

# Lokale SQLite-Datenbank (Prisma) — i.d.R. nicht ändern
DATABASE_URL="file:./prisma/dev.db"

# ── Anthropic (Content-Engine) ──────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ── Meta Graph API (Instagram + Facebook, Meta Ads) ─────────
# https://developers.facebook.com/apps -> App anlegen -> Graph API Explorer
# Benötigt: Instagram-Business-Konto verknüpft mit einer Facebook-Seite
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_AD_ACCOUNT_ID=

# ── Google Ads API ───────────────────────────────────────────
# https://ads.google.com/aw/apicenter -> Developer Token beantragen
# https://console.cloud.google.com -> OAuth-Client für Google Ads erstellen
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Google Drive (Asset-Bibliothek via MCP) ─────────────────
# https://console.cloud.google.com -> OAuth-Client (Desktop) + Drive API aktivieren
# Wird zusätzlich als MCP-Server unter Einstellungen -> MCP-Server eingetragen
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ── Bild-/Video-Generierung (MCP, z.B. Higgsfield) ──────────
# API-Key laut Anbieter-Dashboard; die Server-URL wird unter
# Einstellungen -> MCP-Server konfiguriert (kein Code-Change nötig)
HIGGSFIELD_API_KEY=
MIDJOURNEY_API_KEY=
RUNWAY_API_KEY=

# ── E-Mail-Versand (optional, für Kommunikation-Modul) ──────
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ── WhatsApp Business API (optional) ────────────────────────
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
