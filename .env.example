# --- Datenbank ---
# Lokal (Docker Compose): postgresql://agentur_os:agentur_os@postgres:5432/agentur_os
# Lokal (ohne Docker):    postgresql://agentur_os:agentur_os@localhost:5432/agentur_os
DATABASE_URL="postgresql://agentur_os:agentur_os@localhost:5432/agentur_os"
POSTGRES_USER="agentur_os"
POSTGRES_PASSWORD="agentur_os"
POSTGRES_DB="agentur_os"

# --- Redis (BullMQ Hintergrund-Jobs: Backups, Deployments, Kampagnen-Sync) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generieren mit: npx auth secret
AUTH_SECRET="change-me-to-a-random-64-char-string"
AUTH_URL="http://localhost:3000"

# --- Verschlüsselung für den API-Key-Vault (32 Bytes, AES-256-GCM) ---
ENCRYPTION_KEY="change-me-to-a-random-32-byte-value"

# --- KI-Anbindung ---
ANTHROPIC_API_KEY=""

# --- Bild-/Videogenerierung (optional, pro Agentur im Admin hinterlegbar) ---
FAL_API_KEY=""
REPLICATE_API_TOKEN=""
OPENAI_API_KEY=""

# --- Onepage MCP (optionaler Website-Publishing-Kanal) ---
ONEPAGE_MCP_URL=""
ONEPAGE_MCP_TOKEN=""

# --- Reverse Proxy / Domain (für Caddy) ---
AGENCY_DOMAIN="localhost"

# --- Backup-Ziele (S3-kompatibel, z.B. Hetzner Storage Box, Backblaze B2) ---
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
